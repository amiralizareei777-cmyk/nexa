<Window x:Class="Nexa.App.Windows.WakeGlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Grid IsHitTestVisible="False">
        <Border Height="5" VerticalAlignment="Top" Opacity="0.8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF8F80" Offset="0"/>
                    <GradientStop Color="#FFD980" Offset="0.25"/>
                    <GradientStop Color="#80DCAA" Offset="0.5"/>
                    <GradientStop Color="#80BFFF" Offset="0.75"/>
                    <GradientStop Color="#C4A0FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect Color="#68AFFF" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        </Border>
        <Border Height="5" VerticalAlignment="Bottom" Opacity="0.8">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                    <GradientStop Color="#FF8F80" Offset="0"/>
                    <GradientStop Color="#FFD980" Offset="0.25"/>
                    <GradientStop Color="#80DCAA" Offset="0.5"/>
                    <GradientStop Color="#80BFFF" Offset="0.75"/>
                    <GradientStop Color="#C4A0FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect><DropShadowEffect Color="#68AFFF" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
        </Border>
        <Border Width="5" HorizontalAlignment="Left" Background="#85C8FF" Opacity="0.75">
            <Border.Effect><DropShadowEffect Color="#85C8FF" BlurRadius="22" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
        </Border>
        <Border Width="5" HorizontalAlignment="Right" Background="#C0A0FF" Opacity="0.75">
            <Border.Effect><DropShadowEffect Color="#C0A0FF" BlurRadius="22" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
        </Border>
    </Grid>
</Window>
