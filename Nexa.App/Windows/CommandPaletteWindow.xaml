<Window x:Class="Nexa.App.Windows.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource CommandPaletteWindow}"
        Title="Nexa" Icon="/Nexa;component/Assets/nexa.ico"
        Width="980" Height="700" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="18"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Nexa;component/Assets/nexa.png" Width="58" Height="58"
                               Stretch="Uniform" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXA" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Your voice and desktop companion" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ConnectionSummary}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Ask a question, open an app, find a file, or create something new."
                               TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                               FontSize="15" Margin="2,14,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Guide" Click="Guide_Click" Style="{StaticResource IconButton}"
                            Width="72" Margin="0,0,8,0" ToolTip="How to connect a provider and use Nexa"/>
                    <Button Content="Settings" Click="Settings_Click" Style="{StaticResource IconButton}"
                            Width="84" Margin="0,0,8,0" ToolTip="AI and voice settings"/>
                    <Button Click="MicrophoneMute_Click" Width="138" Height="40" ToolTip="Stop all microphone listening; text chat stays available">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="Mute microphone"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MicrophoneMuted}" Value="True">
                                        <Setter Property="Content" Value="Mic off · Unmute"/>
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox x:Name="CommandTextBox" Style="{StaticResource CommandTextBox}"
                             Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="76" MaxHeight="170"
                             KeyDown="CommandTextBox_KeyDown"/>
                    <TextBlock Text="Ask Nexa or tell it what to do..."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="15"
                               Margin="16,14,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CommandTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,4">
                    <Button Command="{Binding VoiceCommand}" Content="🎙 Listen"
                            Width="110" Height="38" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MicrophoneMuted}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="ToolTip" Value="Unmute the microphone to use voice"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SessionActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding StopSessionCommand}" Content="Stop listening"
                            Style="{StaticResource IconButton}" Width="120" Height="38"
                            Visibility="{Binding SessionActive, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}"
                            Content="Send message" MinWidth="118"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="Enter: send  •  Shift+Enter: new line  •  Alt+Space: open Nexa  •  F11: full screen"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="4,7,0,5"/>
        <WrapPanel Grid.Row="3" Margin="2,4,0,12">
            <TextBlock Text="OPEN APPS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="FIND FILES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="CREATE FILES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock Text="VOICE CONTROL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
        </WrapPanel>
        <StackPanel Grid.Row="4" Margin="0,4,0,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"
                       Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}"
                       TextWrapping="Wrap" Margin="0,0,0,5"/>
            <StackPanel Visibility="{Binding HasPendingConfirmation, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding PendingConfirmationText}" Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding DeclinePendingCommand}"
                            Style="{StaticResource IconButton}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Run" Command="{Binding ConfirmPendingCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="16" Margin="0,0,0,10" Cursor="Hand"
                                MouseLeftButtonDown="ResultItem_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
